{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IRify Benchmark Finding Result",
  "type": "object",
  "required": ["tool", "findings_count", "findings"],
  "properties": {
    "tool": { "type": "string" },
    "project": { "type": "string" },
    "source": { "type": "string" },
    "summary": { "type": "object" },
    "findings_count": { "type": "integer", "minimum": 0 },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tool", "rule_type", "file_path", "line_start", "line_end", "source_report"],
        "properties": {
          "tool": { "type": "string" },
          "rule_type": { "type": "string" },
          "title": { "type": "string" },
          "severity": { "type": "string" },
          "file_path": { "type": "string" },
          "line_start": { "type": "integer", "minimum": 1 },
          "line_end": { "type": "integer", "minimum": 1 },
          "source": { "type": ["string", "null"] },
          "sink": { "type": ["string", "null"] },
          "evidence": { "type": "string" },
          "source_report": { "type": "string" },
          "confidence": { "type": "string" }
        }
      }
    }
  }
}

