{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IRify Benchmark Annotation Set",
  "type": "object",
  "required": ["project", "cases"],
  "properties": {
    "project": { "type": "string" },
    "source": { "type": "string" },
    "notes": { "type": "array", "items": { "type": "string" } },
    "metadata": { "type": "object" },
    "annotations": {
      "type": "array",
      "items": { "$ref": "#/$defs/case" }
    },
    "cases": {
      "type": "array",
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "location": {
      "type": "object",
      "properties": {
        "kind": { "type": "string" },
        "file_path": { "type": "string" },
        "line_start": { "type": "integer", "minimum": 1 },
        "line_end": { "type": "integer", "minimum": 1 },
        "api": { "type": "string" },
        "params": { "type": "array", "items": { "type": "object" } },
        "notes": { "type": "string" },
        "symbol": { "type": "string" },
        "source_tool": { "type": "string" },
        "evidence": { "type": "string" }
      }
    },
    "case": {
      "type": "object",
      "required": ["case_id", "scenario_id", "family", "route", "expectation", "rule_type", "canonical_file_path", "line_start", "line_end", "irify_support"],
      "properties": {
        "case_id": { "type": "string" },
        "scenario_id": { "type": "string" },
        "family": { "type": "string" },
        "module": { "type": "string" },
        "controller_name": { "type": "string" },
        "controller_path": { "type": "string" },
        "canonical_file_path": { "type": "string" },
        "class_route": { "type": "string" },
        "route": { "type": "string" },
        "method_name": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "expectation": { "type": "string", "enum": ["must_alert", "must_not_alert", "informational_only"] },
        "line_start": { "type": "integer", "minimum": 1 },
        "line_end": { "type": "integer", "minimum": 1 },
        "source": { "$ref": "#/$defs/location" },
        "sink": { "anyOf": [{ "$ref": "#/$defs/location" }, { "type": "null" }] },
        "trace": { "type": "array", "items": { "$ref": "#/$defs/location" } },
        "safe_guards": { "type": "array", "items": { "type": "object" } },
        "rule_type": { "type": "string" },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "irify_support": { "type": "string", "enum": ["supported", "unsupported"] },
        "irify_rule_candidates": { "type": "array", "items": { "type": "object" } },
        "scan_observed_rules": { "type": "object" },
        "verification_status": { "type": "object" },
        "alias_locations": { "type": "array", "items": { "type": "string" } },
        "source_refs": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
